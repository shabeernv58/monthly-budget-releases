{
  "version": 1,
  "note": "Read in order; the first rule that matches decides. Patterns work in Java and JavaScript. Group names: letters and digits only.",
  "banks": [
    [
      "mashreq",
      "Mashreq"
    ],
    [
      "emirates ?nbd|enbd",
      "ENBD"
    ],
    [
      "adcb",
      "ADCB"
    ],
    [
      "\\bfab\\b|first abu dhabi",
      "FAB"
    ],
    [
      "\\brak ?bank|rakbank",
      "RAKBANK"
    ],
    [
      "\\bdib\\b|dubai islamic",
      "DIB"
    ],
    [
      "\\bcbd\\b|commercial bank of dubai",
      "CBD"
    ],
    [
      "\\bhsbc\\b",
      "HSBC"
    ],
    [
      "wio",
      "Wio"
    ],
    [
      "liv\\b",
      "Liv"
    ]
  ],
  "rules": [
    {
      "id": "otp",
      "kind": "skip",
      "match": "(?i)\\b(otp|one[- ]time password|verification code|passcode)\\b",
      "fields": []
    },
    {
      "id": "dewaBill",
      "kind": "bill",
      "biller": "DEWA",
      "match": "(?i)Your (?<billMonth>[A-Za-z]+) bill \\((?<period>[^)]*)\\) for account (?<account>\\S+) is AED ?(?<amount>[\\d,]+(?:\\.\\d+)?)",
      "fields": [
        "billMonth",
        "period",
        "account",
        "amount"
      ]
    },
    {
      "id": "cardPurchase",
      "kind": "purchase",
      "match": "(?i)Purchase of AED ?(?<amount>[\\d,]+(?:\\.\\d+)?) with (?<cardType>Debit|Credit|Prepaid) Card ending (?<card>\\d{4}) at (?<merchant>.+?)(?:, (?<city>[^.,]+))?\\.(?: Avl\\.? Balance is AED ?(?<balance>[\\d,]+(?:\\.\\d+)?))?",
      "fields": [
        "amount",
        "cardType",
        "card",
        "merchant",
        "city",
        "balance"
      ]
    },
    {
      "id": "oasisWallet",
      "kind": "wallet",
      "merchant": "Oasis Drinking Water",
      "match": "(?i)Transaction complete with AED ?(?<amount>[\\d,]+(?:\\.\\d+)?)\\. New Wallet \\((?<wallet>\\d+)\\) Balance is AED ?(?<balance>[\\d,]+(?:\\.\\d+)?)",
      "fields": [
        "amount",
        "wallet",
        "balance"
      ]
    },
    {
      "id": "walletLow",
      "kind": "info",
      "match": "(?i)wallet balance is low",
      "fields": []
    },
    {
      "id": "cardStatement",
      "kind": "statement",
      "match": "(?is)stmt for your Credit Card ending (?<card>\\d{4}).*?Total due AED ?(?<total>[\\d,]+(?:\\.\\d+)?)\\s*;?\\s*Min\\.? ?due AED ?(?<min>[\\d,]+(?:\\.\\d+)?)\\.?\\s*Due date (?<due>\\d{1,2}/\\d{1,2}/\\d{2,4})",
      "fields": [
        "card",
        "total",
        "min",
        "due"
      ]
    },
    {
      "id": "cardRefund",
      "kind": "refund",
      "match": "(?i)Purchase amount of AED ?(?<amount>[\\d,]+(?:\\.\\d+)?) at (?<merchant>.+?) has been refunded to your (?:(?<bank>[A-Za-z]+) )?(?<cardType>Credit|Debit) Card ending with X*(?<card>\\d{4})(?: on (?<date>\\d{1,2}-\\d{1,2}-\\d{2,4}))?",
      "fields": [
        "amount",
        "merchant",
        "bank",
        "cardType",
        "card",
        "date"
      ]
    },
    {
      "id": "cardPayment",
      "kind": "cardPayment",
      "match": "(?i)Your payment of AED ?(?<amount>[\\d,]+(?:\\.\\d+)?) has been received against your (?:(?<bank>[A-Za-z]+) )?[A-Za-z ]*?card ending (?<card>\\d{4})(?: on (?<date>\\d{1,2}/\\d{1,2}/\\d{2,4}))?",
      "fields": [
        "amount",
        "bank",
        "card",
        "date"
      ]
    },
    {
      "id": "installment",
      "kind": "installment",
      "match": "(?i)Transaction of AED ?(?<amount>[\\d,]+(?:\\.\\d+)?) at (?<merchant>.+?) converted to (?<n>\\d+) monthly installments of AED ?(?<inst>[\\d,]+(?:\\.\\d+)?)",
      "fields": [
        "amount",
        "merchant",
        "n",
        "inst"
      ]
    },
    {
      "id": "salary",
      "kind": "salary",
      "match": "(?is)(?=.*\\bsalary\\b)(?=.*\\b(credited|deposited|received|transferred)\\b).*?AED ?(?<amount>[\\d,]+(?:\\.\\d+)?)",
      "fields": [
        "amount"
      ]
    },
    {
      "id": "cardUsed",
      "kind": "purchase",
      "match": "(?is)(?:(?<cardType>Credit|Debit|Prepaid) )?Card(?: ending| no\\.?| number)?(?: with)?\\s*[Xx*]*(?<card>\\d{4})\\b[^.]*?\\b(?:was |has been |is )?used\\b[^.]*?(?<![A-Za-z])(?<cur>AED|DHS?|USD|EUR|GBP|SAR|QAR|OMR|BHD|KWD|INR|PKR|EGP|JOD|JPY|CNY|CAD|AUD|CHF|SGD|HKD|TRY|THB|MYR|LKR|PHP|\\$)\\.?\\s?(?<amount>\\d[\\d,]*(?:\\.\\d+)?)(?:\\s+at\\s+(?<merchant>[^\\n]+?))?(?=\\s+on\\s|\\.\\s|\\.$|,|\\n|$)",
      "fields": [
        "cardType",
        "card",
        "cur",
        "amount",
        "merchant"
      ]
    },
    {
      "id": "genericDebit",
      "kind": "unknown",
      "match": "(?is)(?=.*\\b(debited|purchase|spent|paid|payment|withdrawn|withdrawal|deducted|charged|used|transaction|transferred to|sent to|txn)\\b).*?(?<![A-Za-z])(?<cur>AED|DHS?|USD|EUR|GBP|SAR|QAR|OMR|BHD|KWD|INR|PKR|EGP|JOD|JPY|CNY|CAD|AUD|CHF|SGD|HKD|TRY|THB|MYR|LKR|PHP|\\$)\\.?\\s?(?<amount>\\d[\\d,]*(?:\\.\\d+)?)",
      "fields": [
        "cur",
        "amount"
      ]
    },
    {
      "id": "genericDebitAfter",
      "kind": "unknown",
      "match": "(?is)(?=.*\\b(debited|purchase|spent|paid|payment|withdrawn|withdrawal|deducted|charged|used|transaction|transferred to|sent to|txn)\\b).*?(?<amount>\\d[\\d,]*(?:\\.\\d+)?)\\s?(?<cur>AED|DHS?|USD|EUR|GBP|SAR|QAR|OMR|BHD|KWD|INR|PKR|EGP|JOD|JPY|CNY|CAD|AUD|CHF|SGD|HKD|TRY|THB|MYR|LKR|PHP)\\b",
      "fields": [
        "amount",
        "cur"
      ]
    },
    {
      "id": "genericCredit",
      "kind": "unknownCredit",
      "match": "(?is)(?=.*\\b(credited|deposited|received|refunded|reversed)\\b).*?(?<![A-Za-z])(?<cur>AED|DHS?|USD|EUR|GBP|SAR|QAR|OMR|BHD|KWD|INR|PKR|EGP|JOD|JPY|CNY|CAD|AUD|CHF|SGD|HKD|TRY|THB|MYR|LKR|PHP|\\$)\\.?\\s?(?<amount>\\d[\\d,]*(?:\\.\\d+)?)",
      "fields": [
        "cur",
        "amount"
      ]
    },
    {
      "id": "genericCreditAfter",
      "kind": "unknownCredit",
      "match": "(?is)(?=.*\\b(credited|deposited|received|refunded|reversed)\\b).*?(?<amount>\\d[\\d,]*(?:\\.\\d+)?)\\s?(?<cur>AED|DHS?|USD|EUR|GBP|SAR|QAR|OMR|BHD|KWD|INR|PKR|EGP|JOD|JPY|CNY|CAD|AUD|CHF|SGD|HKD|TRY|THB|MYR|LKR|PHP)\\b",
      "fields": [
        "amount",
        "cur"
      ]
    }
  ]
}